<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # One host for search engines: send the bare domain to www.
  RewriteCond %{HTTP_HOST} ^bread-plus-butter\.com$ [NC]
  RewriteRule ^ https://www.bread-plus-butter.com%{REQUEST_URI} [R=301,L]

  # Stop processing if request is already for index.html or 200.html
  RewriteRule ^(index|200)\.html$ - [L]

  # If requested file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all dynamic routes to Nuxt SPA fallback
  RewriteRule . /200.html [L]
</IfModule>

# Fallback in case mod_rewrite is not evaluated
ErrorDocument 404 /200.html
